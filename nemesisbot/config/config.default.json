{
  "agents": {
    "defaults": {
      "workspace": "~/.nemesisbot/workspace",
      "restrict_to_workspace": true,
      "llm": "zhipu/glm-4.7-flash",
      "max_tokens": 8192,
      "temperature": 0.7,
      "max_tool_iterations": 0,
      "session_token_budget": 0,
      "rate_limit_retries": 10,
      "concurrent_request_mode": "queue",
      "queue_size": 8,
      "max_continuation_permits": 0
    }
  },
  "executor": {
    "enabled": false,
    "sandbox": false,
    "persistent": {
      "enabled": false,
      "max_slots": 4,
      "idle_shutdown_secs": 300,
      "call_timeout_secs": 600
    },
    "vm": {
      "enabled": false,
      "arch": "x86_64",
      "hypervisor": "auto",
      "desktop": "minimal",
      "image": {
        "source": "https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2",
        "sha256": ""
      },
      "resources": { "vcpu": 2, "ram_mb": 2048, "disk_gb": 20 },
      "max_instances": 2,
      "idle_sleep_secs": 300,
      "gc": { "max_total_disk_gb": 50, "over_limit": "warn" }
    }
  },
  "connectors": {
    "enabled": true,
    "max_ops_per_hour": 0,
    "finance": {
      "max_order_qty": 0,
      "max_orders_per_day": 0
