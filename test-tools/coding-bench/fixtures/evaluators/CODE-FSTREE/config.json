{
  "inject": [
    { "src": "tests.rs", "dst": "crates/nemesis-web/src/handlers/fs/tests.rs" }
  ],
  "commands": [
    { "argv": ["cargo", "test", "-p", "nemesis-web", "--features", "workflow", "--lib", "fs::"] }
