# Preset: desktop
# 桌面全功能：默认三通道 + 可选子系统，标准 release profile。
# 加载：nemesis-config load desktop

[features]
channels-web = true
channels-webhook = true
channels-rpc = true
channels-telegram = false
channels-discord = false
channels-slack = false
channels-feishu = false
channels-dingtalk = false
channels-onebot = false
channels-tencent = false
channels-email = false
channels-matrix = false
channels-irc = false
channels-signal = false
channels-mastodon = false
channels-bluesky = false
channels-whatsapp = false
channels-mqtt = false
channels-wecom = false
channels-mattermost = false
channels-nostr = false
channels-wechat = false
# websocket/external：SDK 式本地集成（websocket 独立监听面 + external 子进程桥），桌面默认开；
# maixcam（嵌入式视觉模组）/line（IM）桌面场景不用
channels-websocket = true
channels-external = true
channels-maixcam = false
channels-line = false
migrate = true
devices = true
desktop = true
health = true
heartbeat = true
auth = true
voice = true
voice-capture = true
cluster = true
forge = true
memory = true
workflow = true
security = true
scanner = true
sandbox = true
# P5 桌面级 VM：桌面全量随默认开（运行期另有 executor.vm.enabled 安全闸，默认 false）
vm = true
vm-display = true
eval = true
board = true
# 紫微系统（三方程序受控接管，窄门面三 crate + payload DLL 内嵌）：桌面全量随默认开
# （编译闸而已；运行闸 config ziwei.enabled 默认 false）
ziwei = true
# 行动代理连接器：桌面全量保留（connector 工具 + 安全管线同源）
connectors = true
terminal = true
usage = true
# code_run 脚本工具（QuickJS 沙箱，默认开）：桌面全量随默认
codemode = true
skins = true
# 锁定版旗标（签名验证强制）：消费版预设恒关；CI 锁定包由 daily-release 显式启用
verify-enforce-lock = false

# WASM 插件：桌面全量含沙盒化组件插件
plugins-wasm = true

# L9 版本自切换：桌面全量随默认开
selfupdate = true

# ── 2026-10-17 体积细粒度四件套：桌面全量随默认开 ──
pricing-embed = true
verify = true
web-static = true
lsp = true
# ── 2026-10-17 agent 重依赖四件套：桌面全量随默认开 ──
checkpoint-git = true
image-process = true
history-search = true
usage-store = true


[enums]
build-profile = "release"
