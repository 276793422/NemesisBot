# Preset: minimal-agent
# U17 SDK 配套「最小 agent 档」：只保留 web 对话通道（SDK 走 web /ws），关掉
# 全部可选子系统与外部通道，release profile（agent 工具栈是核心，不随 feature 裁）。
# 工具数量的最小化由运行时 model tier 供给（mini 档核心 13 工具），非编译期 feature。
# 加载：nemesis-config load minimal-agent

[features]
channels-web = true
channels-webhook = false
channels-rpc = false
channels-telegram = false
channels-discord = false
channels-slack = false
channels-feishu = false
channels-dingtalk = false
channels-onebot = false
channels-tencent = false
channels-email = false
channels-matrix = false
channels-irc = false
channels-signal = false
channels-mastodon = false
channels-bluesky = false
channels-whatsapp = false
channels-mqtt = false
channels-wecom = false
channels-mattermost = false
channels-nostr = false
channels-wechat = false
channels-websocket = false
channels-external = false
channels-maixcam = false
channels-line = false
migrate = false
devices = false
desktop = false
health = false
heartbeat = false
auth = false
voice = false
voice-capture = false
cluster = false
forge = false
memory = false
workflow = false
security = false
# 病毒扫描（第 7 层）随安全中间件一起关
scanner = false
sandbox = false
eval = false
board = false
# 行动代理连接器：最小形态无 connector 编排场景，关（连带 security 整包退出）
connectors = false
terminal = false
usage = false
# code_run 脚本工具：rquickjs C 引擎体积大，最小形态关（plugins-wasm 同款理由）
codemode = false
# 皮肤包系统：最小形态无 dashboard 消费面
skins = false
# 锁定版旗标（签名验证强制）：消费版预设恒关；CI 锁定包由 daily-release 显式启用
verify-enforce-lock = false

# WASM 插件：wasmtime 二进制 +9.35MB，IoT/最小形态关（panic=abort 相容性已实证无碍，纯体积取舍）
plugins-wasm = false

# L9 版本自切换：最小形态关
selfupdate = false

# ── 2026-10-17 体积细粒度四件套：最小形态全关 ──
# 内嵌价目表：最小形态成本核算无消费面，关
pricing-embed = false
# 启动签名自验：最小形态关
verify = false
# 内嵌前端资源：SDK 走 /ws 不吃 dashboard，关
web-static = false
# LSP 语义代码查询：最小形态关
lsp = false
# ── 2026-10-17 agent 重依赖四件套：最小形态全关 ──
# checkpoint 影子库（libgit2 ~1.5MB）：关 = 恒 JSON 快照回落
checkpoint-git = false
# 图片降采样（~0.8MB）：最小形态无多模态消费面，关
image-process = false
# FTS 会话全文检索：与 usage-store 一起构成 SQLite 拆分两半，最小形态关
history-search = false
# SQLite 用量账本（rusqlite bundled ~1MB，最小形态不需要）：关 = 空账本 stub
usage-store = false


[enums]
build-profile = "release"
