# Preset: minimal-iot
# IoT / 低资源场景：web 对话 + RPC + MQTT（P28 传感器通道，rumqttc 纯 TCP），
# 最小体积 profile，砍掉其余可选子系统。
# 加载：nemesis-config load minimal-iot

[features]
channels-web = true
channels-webhook = false
channels-rpc = true
channels-telegram = false
channels-discord = false
channels-slack = false
channels-feishu = false
channels-dingtalk = false
channels-onebot = false
channels-tencent = false
channels-email = false
channels-matrix = false
channels-irc = false
channels-signal = false
channels-mastodon = false
channels-bluesky = false
channels-whatsapp = false
channels-mqtt = true
channels-wecom = false
channels-mattermost = false
channels-nostr = false
channels-wechat = false
channels-websocket = false
channels-external = false
channels-maixcam = false
channels-line = false
migrate = false
devices = false
desktop = false
health = false
heartbeat = false
auth = false
voice = false
voice-capture = false
cluster = false
# 集群跨网 P2P（iroh QUIC）：依赖 cluster（已关），IoT 恒关
cluster-roaming = false
forge = false
# ── 全部 4 个 Class C 内核 phase 已完成（forge/memory/workflow/security）。无过渡 pin。
memory = false
workflow = false
security = false
# 病毒扫描（第 7 层）随安全中间件一起关
scanner = false
sandbox = false
# P5 桌面级 VM：IoT/低资源恒关（需 KVM/WHPX + base 镜像磁盘预算，IoT 无消费面）
vm = false
eval = false
board = false
# 行动代理连接器：IoT 无 connector 编排场景，关（连带 security 整包退出）
connectors = false
terminal = false
usage = false
# code_run 脚本工具：rquickjs C 引擎体积大，IoT 恒关（features.toml 明示建议）
codemode = false
# 皮肤包系统：IoT 无 dashboard 消费面（.nbskin 分发 + 设置页管理 + 前端热切）
skins = false
# 锁定版旗标（签名验证强制）：消费版预设恒关；CI 锁定包由 daily-release 显式启用
verify-enforce-lock = false

# WASM 插件：wasmtime 二进制 +9.35MB，IoT/最小形态关（panic=abort 相容性已实证无碍，纯体积取舍）
plugins-wasm = false

# L9 版本自切换：IoT 无升级通道，关
selfupdate = false

# ── 2026-10-17 体积细粒度四件套：IoT 全关 ──
# 内嵌价目表（+0.6MB）：IoT 成本核算无消费面，关（成本恒 0.0 诚实降级）
pricing-embed = false
# 启动签名自验：IoT 可信环境（本地/侧载分发），关
verify = false
# 内嵌前端资源（裁剪后 ~1.2MB）：IoT 纯对话无 dashboard 消费面，关
web-static = false
# LSP 语义代码查询：IoT 无代码开发场景，关
lsp = false
# ── 2026-10-17 agent 重依赖四件套：IoT 全关 ──
# checkpoint 影子库（libgit2 ~1.5MB）：关 = 恒 JSON 快照回落
checkpoint-git = false
# 图片降采样（~0.8MB）：IoT 无多模态场景，关
image-process = false
# FTS 会话全文检索：与 usage-store 一起构成 SQLite 拆分两半，IoT 无消费面，关
history-search = false
# SQLite 用量账本（rusqlite bundled ~1MB，iotsmall 最后一个 SQLite 来源）：关 = 空账本 stub
usage-store = false


[enums]
build-profile = "iotsmall"
